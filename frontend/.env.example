# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in a key. .env.local is gitignored.
# Next reads it at startup, so restart `npm run dev` after changing anything.
#
# Both providers can be configured at once — they appear in one voice menu so
# the same sentence can be compared by ear without a redeploy. With neither
# key she still mouths the words silently and the UI says why; nothing breaks.
# ---------------------------------------------------------------------------

# ---- OpenAI -----------------------------------------------------------------
# Cheap (~$0.015/min) and reliable. Eleven fixed voices, no cloning, all fairly
# neutral in character.
OPENAI_API_KEY=

# gpt-4o-mini-tts follows the tone instructions below. tts-1 is cheaper and
# ignores them; tts-1-hd is the higher-quality version of the same.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# alloy · ash · ballad · coral · echo · fable · nova · onyx · sage · shimmer · verse
# OPENAI_TTS_VOICE=nova

# Plain-language delivery direction. Only the gpt-4o models read it.
# OPENAI_TTS_INSTRUCTIONS=Warm, calm and unhurried.

# ---- ElevenLabs -------------------------------------------------------------
# Roughly 5-10x the cost, and the only one of the two with a voice library,
# voice cloning and voice design — which is what a character voice needs.
# Free tier is ~10k credits/month (~20 min on Flash) and is NON-COMMERCIAL.
ELEVENLABS_API_KEY=

# Flash is half the credit cost of Multilingual v2 AND lower latency, which is
# what the chunking design exists to protect. Use eleven_multilingual_v2 only
# if you are willing to wait for quality.
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Voice id (the opaque string, not the name). Unset means the first voice on
# the account. Pick one from the menu and it is shown in the dev panel.
# ELEVENLABS_VOICE=

# Judged by ear. 0-1 each.
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.75

# ---- Shared -----------------------------------------------------------------
# Which provider handles a voice id that carries no `provider:` prefix.
# TTS_PROVIDER=openai

# Ceilings on one synthesis request. The client chunks well below maxChars.
# TTS_TIMEOUT_MS=20000
# TTS_MAX_CHARS=1000
