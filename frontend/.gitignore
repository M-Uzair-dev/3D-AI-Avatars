# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example is documentation: it names the variables without holding
# any of their values, and a checkout with no record of them is a checkout
# nobody can configure.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# VRM models and animations. The rule and the reasoning are in the repo-root
# .gitignore; this file repeats the deny so that `frontend/` is self-contained,
# and repeats the exceptions because the NEAREST .gitignore wins — an exception
# at the root alone is silently overridden here.
#
# What decides it: `redistribution=allow|disallow` in each model's own licence
# URL, which is a different flag from `commercial_use`. `npm run licences`.
*.vrm
*.vrma

# The pixiv motion pack, committed for the demo phase only -- see the repo-root
# .gitignore for the terms this is an exception to, and what undoing it takes.
!public/animations/*.vrma

# The five whose metadata says `redistribution=allow`.
!public/free-1.vrm
!public/free-2.vrm
!public/free-3.vrm
!public/free-5.vrm
!public/free-6.vrm
